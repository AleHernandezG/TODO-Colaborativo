{
  "expo": {
    "name": "Lista de la compra",
    "slug": "agora",
    "version": "1.0.0",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "listacompra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alejandrohernandez.listacompra"
    },
    "android": {
      "package": "com.alejandrohernandez.listacompra",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71d86290-0336-43db-8359-f9809c7b0dc2"
      }
    },
    "owner": "alejes0407s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71d86290-0336-43db-8359-f9809c7b0dc2"
    }
  }
}
