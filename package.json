{
  "name": "lista-compra-colaborativa",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test .maestro",
    "test:rls": "node --env-file=.env scripts/rls-isolation-test.mjs",
    "test:realtime": "node --env-file=.env scripts/realtime-check.mjs",
    "users": "node --env-file=.env scripts/auth-users.mjs",
    "catalog:benchmark": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/catalog-source-benchmark.mjs",
    "catalog:ingest": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/catalog-ingest.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "expo": "~57.0.21",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "i18next": "^26.3.6",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.5",
    "react-test-renderer": "^19.2.3",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  }
}
